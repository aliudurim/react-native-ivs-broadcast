{
  "name": "react-native-ivs-broadcast",
  "version": "0.1.0",
  "description": "Amazon IVS low-latency broadcasting (RTMPS) and Real-Time Stages for React Native — Fabric + TurboModules",
  "main": "./lib/module/index.js",
  "types": "./lib/typescript/src/index.d.ts",
  "exports": {
    ".": {
      "react-native-ivs-broadcast-source": "./src/index.ts",
      "types": "./lib/typescript/src/index.d.ts",
      "default": "./lib/module/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "src",
    "lib",
    "android",
    "ios",
    "scripts/fetch-ios-sdk.sh",
    "*.podspec",
    "react-native.config.js",
    "!ios/build",
    "!ios/Frameworks",
    "!android/build",
    "!android/gradle",
    "!android/gradlew",
    "!android/gradlew.bat",
    "!android/local.properties",
    "!**/__tests__",
    "!**/__fixtures__",
    "!**/__mocks__",
    "!**/.*"
  ],
  "scripts": {
    "example": "yarn workspace react-native-ivs-broadcast-example",
    "test": "jest",
    "typecheck": "tsc",
    "lint": "eslint \"**/*.{js,ts,tsx}\"",
    "clean": "del-cli android/build example/android/build example/android/app/build example/ios/build lib",
    "prepare": "bob build",
    "pods": "cd example/ios && pod install",
    "bootstrap": "yarn && yarn pods",
    "e2e:build:ios": "detox build --configuration ios.sim.debug",
    "e2e:test:ios": "detox test --configuration ios.sim.debug --take-screenshots failing",
    "e2e:build:android": "detox build --configuration android.emu.debug",
    "e2e:test:android": "detox test --configuration android.emu.debug --take-screenshots failing",
    "e2e:build:ios:release": "detox build --configuration ios.sim.release",
    "e2e:test:ios:release": "detox test --configuration ios.sim.release --headless --take-screenshots failing",
    "e2e:build:android:release": "detox build --configuration android.emu.release",
    "e2e:test:android:release": "detox test --configuration android.emu.release --headless --take-screenshots failing",
    "release": "release-it --only-version"
  },
  "keywords": [
    "react-native",
    "ios",
    "android",
    "amazon-ivs",
    "ivs",
    "aws",
    "broadcast",
    "live-streaming",
    "rtmps",
    "webrtc",
    "real-time",
    "stages",
    "fabric",
    "turbo-module",
    "new-architecture"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/aliudurim/react-native-ivs-broadcast.git"
  },
  "author": "Durim Aliu <durim.aliu5@gmail.com> (https://github.com/aliudurim)",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/aliudurim/react-native-ivs-broadcast/issues"
  },
  "homepage": "https://github.com/aliudurim/react-native-ivs-broadcast#readme",
  "publishConfig": {
    "registry": "https://registry.npmjs.org/"
  },
  "ivsSdk": {
    "android": "1.47.0",
    "ios": {
      "version": "1.47.0",
      "url": "https://broadcast.live-video.net/1.47.0/AmazonIVSBroadcast-Stages.xcframework.zip",
      "sha256": "5d0276982a3356c22e2251968da56100ac124ae444aa480487ff4ad9f204c87c"
    }
  },
  "devDependencies": {
    "@commitlint/config-conventional": "^19.8.1",
    "@eslint/compat": "^2.1.0",
    "@eslint/eslintrc": "^3.3.6",
    "@eslint/js": "^9.39.5",
    "@react-native-community/cli": "20.1.0",
    "@react-native/babel-preset": "0.86.2",
    "@react-native/eslint-config": "0.86.2",
    "@react-native/jest-preset": "0.86.2",
    "@release-it/conventional-changelog": "^10.0.1",
    "@testing-library/react-native": "^13.3.3",
    "@types/jest": "^29.5.14",
    "@types/react": "^19.2.0",
    "commitlint": "^19.8.1",
    "del-cli": "^7.0.0",
    "detox": "^20.45.1",
    "eslint": "^9.39.5",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-ft-flow": "^3.0.11",
    "eslint-plugin-prettier": "^5.5.6",
    "jest": "^29.7.0",
    "lefthook": "^1.13.6",
    "prettier": "^3.9.6",
    "react": "19.2.3",
    "react-native": "0.86.2",
    "react-native-builder-bob": "^0.43.2",
    "react-test-renderer": "19.2.3",
    "release-it": "^19.0.5",
    "ts-jest": "^29.4.5",
    "turbo": "^2.10.8",
    "typescript": "^6.0.3"
  },
  "peerDependencies": {
    "react": "*",
    "react-native": ">=0.76.0"
  },
  "engines": {
    "node": ">= 20.19.4"
  },
  "workspaces": [
    "example"
  ],
  "packageManager": "yarn@4.11.0",
  "jest": {
    "preset": "@react-native/jest-preset",
    "modulePathIgnorePatterns": [
      "<rootDir>/example/node_modules",
      "<rootDir>/lib/"
    ],
    "testPathIgnorePatterns": [
      "/node_modules/",
      "<rootDir>/e2e/",
      "<rootDir>/example/"
    ]
  },
  "commitlint": {
    "extends": [
      "@commitlint/config-conventional"
    ]
  },
  "release-it": {
    "git": {
      "commitMessage": "chore: release ${version}",
      "tagName": "v${version}"
    },
    "npm": {
      "publish": true
    },
    "github": {
      "release": true
    },
    "plugins": {
      "@release-it/conventional-changelog": {
        "preset": {
          "name": "angular"
        },
        "infile": "CHANGELOG.md"
      }
    }
  },
  "react-native-builder-bob": {
    "source": "src",
    "output": "lib",
    "targets": [
      [
        "module",
        {
          "esm": true
        }
      ],
      [
        "typescript",
        {
          "project": "tsconfig.build.json"
        }
      ]
    ]
  },
  "codegenConfig": {
    "name": "RNIvsBroadcastSpec",
    "type": "all",
    "jsSrcsDir": "src/specs",
    "android": {
      "javaPackageName": "com.ivsbroadcast"
    },
    "ios": {
      "modulesProvider": {
        "RNIvsStage": "RNIvsStageModule"
      },
      "componentProvider": {
        "RNIvsBroadcastView": "RNIvsBroadcastComponentView",
        "RNIvsStageVideoView": "RNIvsStageVideoComponentView"
      }
    }
  },
  "prettier": {
    "quoteProps": "consistent",
    "singleQuote": true,
    "tabWidth": 2,
    "trailingComma": "es5",
    "useTabs": false
  },
  "create-react-native-library": {
    "type": "fabric-view",
    "languages": "kotlin-objc",
    "tools": [
      "eslint",
      "jest",
      "lefthook",
      "release-it"
    ],
    "version": "0.63.1"
  }
}
